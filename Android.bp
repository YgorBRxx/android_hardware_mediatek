soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel/power-libperfmgr",
        "hardware/google/pixel/usb",
        "hardware/google/pixel/pixelstats",
    ],
}

install_symlink {
    name: "mdota_symlink",
    vendor: true,
    installed_location: "etc/mdota",
    symlink_target: "/mnt/vendor/mdota",
}
